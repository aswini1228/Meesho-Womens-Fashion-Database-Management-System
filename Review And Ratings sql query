--  Retrieve Product Review Details
SELECT * FROM Meesho_Reviews;

--  Calculate Average Product Ratings
SELECT Product_ID,
       AVG(Rating) AS Average_Rating
FROM Meesho_Ratings
GROUP BY Product_ID;

-- 1 Identify Highly Rated Products
SELECT Product_ID,
       AVG(Rating) AS Average_Rating
FROM Meesho_Ratings
GROUP BY Product_ID
HAVING AVG(Rating) >= 4;

--  Product Rating Report
SELECT COUNT(Rating) AS Total_Ratings,
       SUM(Rating)   AS Total_Rating,
       AVG(Rating)   AS Average_Rating,
       MAX(Rating)   AS Highest_Rating,
       MIN(Rating)   AS Lowest_Rating
FROM Meesho_Ratings;
