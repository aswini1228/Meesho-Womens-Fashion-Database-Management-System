-- 7. ADVANCED SQL QUERIES
--------------------------------------------------

-- QUERY 1: SUBQUERIES AND NESTED QUERIES

SELECT ORDER_ID, CUSTOMER_ID, TOTAL_AMOUNT, ORDER_STATUS
FROM ORDERS
WHERE TOTAL_AMOUNT > (
    SELECT AVG(TOTAL_AMOUNT)
    FROM ORDERS
)
ORDER BY TOTAL_AMOUNT DESC;

-- QUERY 2: PRODUCTS ABOVE AVERAGE PRICE

SELECT PRODUCT_ID, PRODUCT_NAME, PRICE, STOCK_QUANTITY
FROM MEESHO_PRODUCT
WHERE PRICE > (
    SELECT AVG(PRICE)
    FROM MEESHO_PRODUCT
)
ORDER BY PRICE DESC;

-- QUERY 2.1: PRODUCTS BELOW AVERAGE PRICE

SELECT PRODUCT_ID, PRODUCT_NAME, PRICE, STOCK_QUANTITY
FROM MEESHO_PRODUCT
WHERE PRICE < (
    SELECT AVG(PRICE)
    FROM MEESHO_PRODUCT
)
ORDER BY PRICE ASC;

-- QUERY 3: CUSTOMERS WITH MAXIMUM PURCHASES

SELECT C.CUSTOMER_ID,
       C.CUSTOMER_NAME,
       SUM(O.TOTAL_AMOUNT) AS TOTAL_PURCHASE
FROM CUSTOMER_DETAILS C
JOIN ORDERS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
GROUP BY C.CUSTOMER_ID, C.CUSTOMER_NAME
ORDER BY TOTAL_PURCHASE DESC;

-- QUERY 3.1: FIND MAXIMUM PURCHASE

SELECT MAX(TOTAL_PURCHASE) AS MAXIMUM_PURCHASE
FROM (
    SELECT CUSTOMER_ID,
           SUM(TOTAL_AMOUNT) AS TOTAL_PURCHASE
    FROM ORDERS
    GROUP BY CUSTOMER_ID
);

-- QUERY 3.2: CUSTOMER DETAILS WITH MAXIMUM PURCHASE

SELECT C.CUSTOMER_ID,
       C.CUSTOMER_NAME,
       C.EMAIL,
       C.PHONE,
       SUM(O.TOTAL_AMOUNT) AS TOTAL_PURCHASE
FROM CUSTOMER_DETAILS C
JOIN ORDERS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
GROUP BY C.CUSTOMER_ID, C.CUSTOMER_NAME,
         C.EMAIL, C.PHONE
HAVING SUM(O.TOTAL_AMOUNT) = (
    SELECT MAX(TOTAL_PURCHASE)
    FROM (
        SELECT SUM(TOTAL_AMOUNT) AS TOTAL_PURCHASE
        FROM ORDERS
        GROUP BY CUSTOMER_ID
    )
);

-- QUERY 4: CUSTOMERS ABOVE AVERAGE ORDER VALUE

SELECT DISTINCT C.CUSTOMER_ID,
       C.CUSTOMER_NAME,
       C.EMAIL,
       C.PHONE
FROM CUSTOMER_DETAILS C
JOIN ORDERS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
WHERE O.TOTAL_AMOUNT > (
    SELECT AVG(TOTAL_AMOUNT)
    FROM ORDERS
)
ORDER BY C.CUSTOMER_ID;

-- QUERY 5: PRODUCTS WHOSE SALES ARE ABOVE AVERAGE

SELECT P.PRODUCT_ID,
       P.PRODUCT_NAME,
       SUM(OD.QUANTITY) AS TOTAL_QUANTITY,
       SUM(OD.QUANTITY * OD.PRICE) AS TOTAL_SALES
FROM MEESHO_PRODUCT P
JOIN ORDER_DETAILS OD
ON P.PRODUCT_ID = OD.PRODUCT_ID
GROUP BY P.PRODUCT_ID, P.PRODUCT_NAME
HAVING SUM(OD.QUANTITY * OD.PRICE) > (
    SELECT AVG(PRODUCT_SALES)
    FROM (
        SELECT SUM(QUANTITY * PRICE) AS PRODUCT_SALES
        FROM ORDER_DETAILS
        GROUP BY PRODUCT_ID
    )
)
ORDER BY TOTAL_SALES DESC;

-- QUERY 6: CUSTOMER PURCHASE REPORT

SELECT C.CUSTOMER_ID,
       C.CUSTOMER_NAME,
       COUNT(O.ORDER_ID) AS NUMBER_OF_ORDERS,
       SUM(O.TOTAL_AMOUNT) AS TOTAL_PURCHASE,
       AVG(O.TOTAL_AMOUNT) AS AVERAGE_ORDER_VALUE
FROM CUSTOMER_DETAILS C
JOIN ORDERS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
GROUP BY C.CUSTOMER_ID, C.CUSTOMER_NAME
ORDER BY TOTAL_PURCHASE DESC;

-- QUERY 7: ADVANCED PRODUCT SALES REPORT

SELECT P.PRODUCT_ID,
       P.PRODUCT_NAME,
       COUNT(DISTINCT OD.ORDER_ID) AS NUMBER_OF_ORDERS,
       SUM(OD.QUANTITY) AS TOTAL_QUANTITY,
       SUM(OD.QUANTITY * OD.PRICE) AS TOTAL_SALES,
       AVG(OD.PRICE) AS AVERAGE_SELLING_PRICE
FROM MEESHO_PRODUCT P
JOIN ORDER_DETAILS OD
ON P.PRODUCT_ID = OD.PRODUCT_ID
GROUP BY P.PRODUCT_ID, P.PRODUCT_NAME
ORDER BY TOTAL_SALES DESC;

-- QUERY 8: CATEGORY-WISE ADVANCED SALES REPORT

SELECT C.CATEGORY_ID,
       C.CATEGORY_NAME,
       COUNT(DISTINCT P.PRODUCT_ID) AS NUMBER_OF_PRODUCTS,
       SUM(OD.QUANTITY) AS TOTAL_QUANTITY,
       SUM(OD.QUANTITY * OD.PRICE) AS TOTAL_SALES,
       AVG(OD.PRICE) AS AVERAGE_SELLING_PRICE
FROM CATEGORY C
JOIN MEESHO_PRODUCT P
ON C.CATEGORY_ID = P.CATEGORY_ID
JOIN ORDER_DETAILS OD
ON P.PRODUCT_ID = OD.PRODUCT_ID
GROUP BY C.CATEGORY_ID, C.CATEGORY_NAME
ORDER BY TOTAL_SALES DESC;

